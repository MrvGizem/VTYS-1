--Barkod sütunu oluşturma ve UNIQUE kısıtı
ALTER TABLE urun
ADD COLUMN barkod VARCHAR(20);

UPDATE urun
SET barkod = 'BRK-' || urun_id;

ALTER TABLE urun
ALTER COLUMN barkod SET NOT NULL;

ALTER TABLE urun
ADD CONSTRAINT uq_urun_barkod
UNIQUE (barkod);
