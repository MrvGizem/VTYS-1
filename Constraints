ALTER TABLE urun
ADD COLUMN aktif_mi BOOLEAN DEFAULT TRUE;

ALTER TABLE urun
ALTER COLUMN aktif_mi SET NOT NULL;

SELECT urun_id, urun_adi, aktif_mi
FROM urun;

-- Negatif fiyat sorunu CHECK
ALTER TABLE urun
ADD CONSTRAINT ck_urun_fiyat
CHECK (fiyat > 0);
