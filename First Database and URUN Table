-- Var olan urun tablosunu SİLMEZ: kayıtları korumak için hata vererek durur.

CREATE TABLE urun (
    urun_id VARCHAR(10) PRIMARY KEY,
    urun_adi VARCHAR(50) NOT NULL,
    kategori VARCHAR(50) NOT NULL,
    fiyat NUMERIC(10,2) NOT NULL,
    stok INTEGER NOT NULL
);

